# Copy to .env and change every value. Never commit .env.

# Postgres
PG_DB=stocksense
PG_USER=stocksense
PG_PASS=change-me-postgres
SEED_DATA=true
# Host port. Use 5433 if a local PostgreSQL already listens on 5432.
PG_PORT=5432

# Redis (duplicate check)
REDIS_PASS=change-me-redis
# Host port. Use 6380 if a local Redis already listens on 6379.
REDIS_PORT=6379

# RabbitMQ (management UI: http://localhost:15672)
RABBITMQ_USER=stocksense
RABBITMQ_PASS=change-me-rabbitmq

# HMAC secrets for webhooks, one per channel (used from Phase 1)
WEBHOOK_SECRET_AMAZON=change-me-amazon
WEBHOOK_SECRET_FLIPKART=change-me-flipkart
WEBHOOK_SECRET_WEBSITE=change-me-website

# JWT signing key for the dashboard API and POS staff tokens (used from Phase 1/4)
JWT_SECRET=change-me-jwt
